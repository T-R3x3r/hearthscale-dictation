{
  "$schema": "https://hearthscale.com/app.schema.json",
  "id": "dictation",
  "name": "Dictation",
  "version": "0.1.0",
  "api": 6,
  "icon": {
    "light": "assets/icon-light.svg",
    "dark": "assets/icon-dark.svg"
  },
  "description": "Hold a key and speak. Clean text appears wherever you type.",
  "license": "MIT",
  "categories": [
    "productivity"
  ],
  "payment": "free",
  "environment": {
    "kind": "process",
    "lifetime": "service"
  },
  "permissions": [
    "clipboard-write"
  ],
  "onboarding": {
    "version": 1,
    "cards": [
      {
        "title": "Speak anywhere you type.",
        "text": "Hold Ctrl+Shift+Space and speak. Let go, and the text appears in the program in front.",
        "image": "assets/intro-speak.svg"
      },
      {
        "title": "Download a speech model.",
        "text": "This model fits your language and runs on this computer. Choose another in Settings.",
        "download": {
          "best": "transcription"
        }
      },
      {
        "title": "Download a chat model.",
        "text": "A chat model removes filler words and keeps your last correction.",
        "download": {
          "kind": "chat",
          "repo": "google/gemma-4-E2B-it-qat-q4_0-gguf",
          "file": "gemma-4-E2B_q4_0-it.gguf"
        }
      },
      {
        "title": "Keys, models and history.",
        "rows": [
          {
            "icon": "check",
            "title": "Keys",
            "text": "A combination or one key, such as Right Ctrl, in Settings."
          },
          {
            "icon": "speech",
            "title": "Models",
            "text": "Any speech and chat model, in Settings."
          },
          {
            "icon": "clock",
            "title": "History",
            "text": "Open it from the tray icon. It stays on this computer."
          }
        ]
      }
    ]
  },
  "uses": [
    "db",
    "events",
    "models",
    "capture.microphone",
    "desktop.around",
    "desktop.actions",
    "desktop.overlay"
  ],
  "models": {
    "transcription": {
      "required": true,
      "input": "microphone",
      "recommend": "recommend_models"
    },
    "chat": {
      "required": false
    }
  },
  "settings": {
    "schema": {
      "type": "object",
      "properties": {
        "keyBehaviour": {
          "type": "string",
          "title": "Key behaviour",
          "enum": [
            "Hold or tap",
            "Hold",
            "Tap"
          ],
          "default": "Hold or tap"
        },
        "insert": {
          "type": "string",
          "title": "Insert text",
          "enum": [
            "Automatic",
            "Type",
            "Paste"
          ],
          "default": "Automatic"
        },
        "cleanUp": {
          "type": "boolean",
          "title": "Clean up text",
          "description": "Runs on your default chat model. A cloud model runs only if you choose it for Dictation.",
          "default": true
        },
        "styles": {
          "type": "boolean",
          "title": "Match the style to the program",
          "default": true
        },
        "words": {
          "type": "array",
          "title": "Dictionary",
          "description": "Names and terms you say. Add what the model writes instead after an equals sign: Parakeet = para keet, para-keet.",
          "items": {
            "type": "string",
            "maxLength": 200
          },
          "maxItems": 100,
          "placeholder": "Add a word or name",
          "default": []
        },
        "history": {
          "type": "boolean",
          "title": "Keep history",
          "default": true
        },
        "microphone": {
          "type": "string",
          "title": "Microphone",
          "optionsFrom": "microphones",
          "default": ""
        },
        "translate": {
          "type": "boolean",
          "title": "Translate to English",
          "description": "On speech models that translate. Speak any language and get English text.",
          "default": false
        },
        "filterSilence": {
          "type": "boolean",
          "title": "Filter silence",
          "description": "Skips the parts with no voice before the speech model hears them, and keeps a short stretch around each word.",
          "default": true
        },
        "removeFillers": {
          "type": "boolean",
          "title": "Remove filler words",
          "description": "Takes out sounds such as \"um\" and \"uh\". Works with no chat model.",
          "default": true
        },
        "aroundCursor": {
          "type": "boolean",
          "title": "Read the text around the cursor",
          "description": "Sends up to 1,024 characters on each side of the cursor to the chat model, to settle what you meant. A password field is never read.",
          "default": true
        },
        "instructionsKind": {
          "type": "string",
          "title": "Instructions",
          "enum": [
            "Built-in",
            "Your own"
          ],
          "default": "Built-in"
        },
        "instructions": {
          "type": "string",
          "title": "Your instructions",
          "description": "Text that keeps fewer than half of your words is not used.",
          "multiline": true,
          "maxLength": 10000,
          "placeholder": "Clean up this dictated text. Keep my words, fix the punctuation, and keep my last correction.",
          "default": ""
        },
        "correction": {
          "type": "string",
          "title": "Correction word",
          "description": "The word you say before a correction, such as \"sorry\" or \"scratch that\".",
          "maxLength": 50,
          "placeholder": "Add a word",
          "default": ""
        }
      }
    },
    "layout": [
      {
        "title": "Speaking",
        "items": [
          {
            "kind": "property",
            "property": "keyBehaviour"
          },
          {
            "kind": "property",
            "property": "microphone",
            "action": {
              "tool": "test_microphone",
              "title": "Test"
            }
          },
          {
            "kind": "property",
            "property": "translate"
          }
        ]
      },
      {
        "title": "Recognition",
        "items": [
          {
            "kind": "property",
            "property": "filterSilence"
          },
          {
            "kind": "property",
            "property": "removeFillers"
          },
          {
            "kind": "property",
            "property": "words"
          }
        ]
      },
      {
        "title": "Text",
        "items": [
          {
            "kind": "property",
            "property": "insert"
          },
          {
            "kind": "property",
            "property": "cleanUp"
          },
          {
            "kind": "property",
            "property": "styles",
            "when": {
              "property": "cleanUp",
              "is": true
            }
          },
          {
            "kind": "property",
            "property": "aroundCursor",
            "when": {
              "property": "cleanUp",
              "is": true
            }
          },
          {
            "kind": "property",
            "property": "correction",
            "when": {
              "property": "cleanUp",
              "is": true
            }
          },
          {
            "kind": "property",
            "property": "instructionsKind",
            "when": {
              "property": "cleanUp",
              "is": true
            }
          },
          {
            "kind": "property",
            "property": "instructions",
            "when": {
              "property": "instructionsKind",
              "is": "Your own"
            }
          }
        ]
      },
      {
        "title": "History",
        "items": [
          {
            "kind": "property",
            "property": "history",
            "action": {
              "tool": "forget_all",
              "title": "Clear",
              "confirm": {
                "title": "Clear the history?",
                "body": "This removes every dictation. You cannot undo this."
              }
            }
          }
        ]
      }
    ]
  },
  "triggers": [
    {
      "name": "dictate",
      "kind": "hotkey",
      "keys": "CommandOrControl+Shift+Space",
      "hold": true
    },
    {
      "name": "cancel",
      "kind": "hotkey",
      "keys": "Escape",
      "armed": false
    },
    {
      "name": "program",
      "kind": "program",
      "events": [
        "front"
      ]
    }
  ],
  "tools": [
    {
      "name": "hud_state",
      "title": "Read the HUD's state",
      "description": "What the HUD shows now.",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "mutating": false,
      "outbound": false,
      "visibility": [
        "app"
      ]
    },
    {
      "name": "history",
      "title": "Read the history",
      "description": "The dictations this computer keeps, newest first.",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "mutating": false,
      "outbound": false,
      "visibility": [
        "app"
      ]
    },
    {
      "name": "forget",
      "title": "Remove from history",
      "description": "Removes one dictation from the history.",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "mutating": true,
      "outbound": false,
      "visibility": [
        "app"
      ]
    },
    {
      "name": "forget_all",
      "title": "Clear history",
      "description": "Removes every dictation from the history.",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "mutating": true,
      "outbound": false,
      "visibility": [
        "app"
      ]
    },
    {
      "name": "recommend_models",
      "title": "Recommend speech models",
      "description": "Which of a search's speech models Dictation recommends for the languages.",
      "input": {
        "type": "object",
        "properties": {
          "languages": {
            "type": "array",
            "items": { "type": "string" }
          },
          "models": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "repo": { "type": "string" },
                "speech": {}
              },
              "required": ["repo", "speech"]
            }
          }
        },
        "required": ["languages", "models"],
        "additionalProperties": false
      },
      "mutating": false,
      "outbound": false,
      "visibility": [
        "app"
      ]
    },
    {
      "name": "microphones",
      "title": "List microphones",
      "description": "The microphones of this computer.",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "mutating": false,
      "outbound": false,
      "visibility": [
        "app"
      ]
    },
    {
      "name": "test_microphone",
      "title": "Test microphone",
      "description": "Opens the microphone test.",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "mutating": false,
      "outbound": false,
      "visibility": [
        "app"
      ],
      "view": "mic-test"
    },
    {
      "name": "mic_test_start",
      "title": "Start the microphone test",
      "description": "Records for up to ten seconds.",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "mutating": true,
      "outbound": false,
      "visibility": [
        "app"
      ]
    },
    {
      "name": "mic_test_stop",
      "title": "Stop the microphone test",
      "description": "Ends the recording of the test.",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "mutating": true,
      "outbound": false,
      "visibility": [
        "app"
      ]
    },
    {
      "name": "mic_test_sound",
      "title": "Read the test's recording",
      "description": "The sound of the microphone test.",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "mutating": false,
      "outbound": false,
      "visibility": [
        "app"
      ]
    },
    {
      "name": "hear_again",
      "title": "Hear a failed dictation again",
      "description": "Transcribes the sound of the dictation that failed.",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "mutating": true,
      "outbound": false,
      "visibility": [
        "app"
      ]
    }
  ],
  "surfaces": [
    {
      "id": "hud",
      "kind": "view",
      "title": "Dictation",
      "entry": "views/hud.js",
      "placements": [
        "overlay"
      ]
    },
    {
      "id": "history",
      "kind": "view",
      "title": "History",
      "entry": "views/history.js",
      "placements": [
        "popover"
      ]
    },
    {
      "id": "mic-test",
      "kind": "view",
      "title": "Test microphone",
      "entry": "views/mic-test.js",
      "placements": [
        "inline"
      ]
    }
  ]
}
